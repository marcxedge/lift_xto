rules_version = '2';

// Reglas de Firestore para Lift.xto. Cada usuario sólo puede leer/escribir
// sus propios datos, bajo users/{uid}/**. Pegar esto en Firebase Console →
// Firestore Database → Reglas (ver README → Sincronización).
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
